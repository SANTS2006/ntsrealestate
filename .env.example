
# ── Reliability ───────────────────────────────────────────────────────────
# Connections this instance may hold to the database. Keep
# (number of instances x DATABASE_POOL_SIZE) under the database's own limit.
DATABASE_POOL_SIZE=10
SESSION_POOL_SIZE=5
REQUEST_TIMEOUT_MS=30000

# ── Backup & Recovery (see docs/operations/backup-and-recovery.md) ─────────
# local = this server's disk (development only: wiped on every redeploy)
# s3    = any S3-compatible bucket: AWS S3, Cloudflare R2, Backblaze B2...
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=./backups
# 64 hex characters (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe and separate: without it encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Daily run time, UTC.
BACKUP_SCHEDULE=02:00
BACKUP_SCHEDULER_ENABLED=true
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
# 24+ random characters. Lets an external scheduler trigger the daily backup:
#   POST /api/v1/internal/backups/run   with header  X-Cron-Secret: <this value>
BACKUP_CRON_SECRET=
# Only when BACKUP_STORAGE=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
