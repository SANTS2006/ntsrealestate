# Only safe, public configuration belongs here. Never put API secrets,
# database credentials, or Cloudinary API secrets in client env vars — Vite
# inlines every VITE_-prefixed variable into the built JS bundle, which is
# publicly readable.
VITE_API_URL=http://localhost:5000/api/v1
# The public marketing/listings site — Terms & Conditions, Privacy Policy,
# and Contact links on the auth pages point here.
VITE_PUBLIC_SITE_URL=https://surprise-realty-listings.vercel.app
