{
  "name": "ntsrealestate",
  "private": true,
  "version": "0.1.0",
  "description": "NTS Real Estate System — a production-grade, multi-tenant real estate management platform.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "start": "npm run start --workspace server",
    "deploy:migrate": "npm run prisma:migrate:deploy --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
