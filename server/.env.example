# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Neon PostgreSQL ──────────────────────────────────────────────────────
# Pooled connection (PgBouncer, transaction mode) — used for all runtime queries.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require"
# Direct connection — used only by `prisma migrate` (session mode required).
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# ── Single tenant ─────────────────────────────────────────────────────────
# This is a single-company deployment, not multi-org SaaS — every new
# registration joins this one organization as a `tenant`. Find/create the
# organization's id via `prisma studio` or a one-off script; there is no
# UI to create it, since registration itself no longer creates organizations.
PRIMARY_ORGANIZATION_ID=

# ── Sessions (browser auth) ──────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# 32-byte hex key (64 chars) for encrypting TOTP MFA secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# ── JWT (mobile / external API / service-to-service auth) ───────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=rems-api
JWT_AUDIENCE=rems-clients

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of exact trusted origins. No wildcards in production.
CORS_ORIGINS=http://localhost:5173

# ── Cloudinary (server-side only — never exposed to the client) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (transactional) ────────────────────────────────────────────────
# Preferred: Brevo's transactional HTTP API. Get a key from
# Brevo → Settings → SMTP & API → API Keys tab. No SMTP login to configure.
BREVO_API_KEY=
EMAIL_FROM_NAME="NTS Real Estate System"
EMAIL_FROM_ADDRESS=
SUPPORT_EMAIL=

# SMTP fallback (used only if BREVO_API_KEY is unset) — works with Brevo's
# SMTP relay or any other provider. EMAIL_USER is your Brevo account login
# email; EMAIL_PASSWORD is an SMTP key from the same SMTP & API page.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="NTS Real Estate System <no-reply@example.com>"

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10
