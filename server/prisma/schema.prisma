// NTS Real Estate System — Prisma schema for Neon PostgreSQL
// Connection strategy: `url` = pooled (runtime), `directUrl` = direct (migrations).
// See docs/database/database-design.md for rationale.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  suspended
  cancelled
}

enum UserStatus {
  pending
  active
  inactive
  locked
}

enum PropertyStatus {
  active
  archived
  under_construction
}

enum PropertyStructure {
  whole
  buildings
  buildings_units
  units
}

enum DealKind {
  rent
  buy
  lease
}

enum DealStatus {
  pending
  approved
  completed
  cancelled
}

enum LandStatus {
  available
  reserved
  sold
  unavailable
}

enum UnitStatus {
  available
  occupied
  reserved
  under_maintenance
  unavailable
}

enum OwnerStatus {
  active
  inactive
}

enum TenantStatus {
  active
  inactive
  former
}

enum LeaseStatus {
  draft
  active
  expiring_soon
  expired
  terminated
  renewed
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  reversed
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  mobile_money
  cheque
  other
}

enum ExpenseStatus {
  pending_approval
  approved
  rejected
  paid
}

enum VendorStatus {
  active
  inactive
}

enum MaintenancePriority {
  low
  medium
  high
  emergency
}

enum MaintenanceStatus {
  open
  in_review
  assigned
  scheduled
  in_progress
  completed
  cancelled
}

enum WorkOrderStatus {
  pending
  scheduled
  in_progress
  completed
  cancelled
}

enum InspectionType {
  move_in
  move_out
  routine
  property
  unit
}

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum DocumentEntityType {
  land
  property
  building
  unit
  tenant
  owner
  lease
  invoice
  payment
  expense
  maintenance_request
  work_order
  inspection
  vendor
  user
  organization
}

enum DocumentStatus {
  active
  archived
  deletion_pending
  deletion_failed
  deleted
}

enum NotificationType {
  rent_due
  rent_overdue
  lease_expiring
  payment_received
  maintenance_assigned
  maintenance_completed
  document_uploaded
  deal_request
  deal_update
  user_invited
  system
  inspection_scheduled
  lease_activated
  invoice_sent
  audit_remark_created
  tenant_message
  referral_used
  referral_bonus_approved
  referral_bonus_paid
  rental_request
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY / RBAC
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  lands              Land[]
  deals              Deal[]
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?            @map("legal_name")
  registrationNumber String?            @map("registration_number")
  email              String
  phone              String?
  address            String?
  city               String?
  region             String?
  country            String?
  logoDocumentId     String?            @map("logo_document_id") @db.Uuid
  // URL path segment this tenant's entire system lives under (e.g.
  // /acme-realty/login, /acme-realty/dashboard) — set once by the platform
  // admin at creation, immutable afterward since it's baked into every link
  // a tenant's users might have bookmarked or been emailed.
  slug               String             @unique
  // Hex colors chosen by the platform admin at creation — applied as CSS
  // custom properties across this tenant's entire system (auth pages
  // through the authenticated dashboard). See client/src/contexts/BrandingContext.jsx.
  primaryColor       String             @default("#0f172a") @map("primary_color")
  secondaryColor     String             @default("#0ea5e9") @map("secondary_color")
  settings           Json               @default("{}")
  status             OrganizationStatus @default(active)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  tenantRentals       TenantRental[]
  chatRooms           ChatRoom[]
  ownerAgents         OwnerAgent[]
  roles               Role[]
  properties          Property[]
  owners              Owner[]
  tenants             Tenant[]
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  vendors             Vendor[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  inspections         Inspection[]
  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  auditRemarks        AuditRemark[]
  propertyAssignments PropertyAssignment[]
  tenantMessages      TenantMessage[]
  referrals           Referral[]

  @@map("organizations")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  email               String
  phone               String?
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(pending)
  emailVerified       Boolean    @default(false) @map("email_verified")
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  // Encrypted (AES-256-GCM), NOT hashed — TOTP verification requires the
  // server to recompute the current code from the raw secret, which a
  // one-way hash makes impossible. See server/src/auth/mfa.js.
  mfaSecretEncrypted  String?    @map("mfa_secret_encrypted")
  // Progressive account lockout — layered on top of the per-IP+email rate
  // limiter on /auth/login (see middleware/security.js authRateLimiter),
  // so brute-forcing survives even a distributed/rotating-IP attacker.
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  // Every user gets one at creation (registration or invite) — only a
  // tenant realistically shares theirs, but generating it uniformly avoids
  // conditional logic at each of the two user-creation call sites. See
  // utils/referralCode.js.
  referralCode        String?    @unique @map("referral_code")
  // Set at registration when the user checks the Terms & Conditions /
  // Privacy Policy agreement box (see auth.service.js#registerOrganization).
  // Null for users created by invite rather than self-registration, since
  // an admin-invited user never sees that checkbox.
  termsAcceptedAt     DateTime?  @map("terms_accepted_at") @db.Timestamptz

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles               UserRole[]
  owner                   Owner?
  tenant                  Tenant?
  notifications           Notification[]
  auditLogs               AuditLog[]
  auditRemarks            AuditRemark[]
  documentsUploaded       Document[]               @relation("DocumentUploadedBy")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  propertyAssignments     PropertyAssignment[]
  tenantMessagesReceived  TenantMessage[]
  referralsMade           Referral[]               @relation("ReferralsMade")
  referredBy              Referral?                @relation("ReferralsReceived")
  ownerLinks              OwnerAgent[]
  chatKey                 ChatKey?
  chatMemberships         ChatMember[]
  chatMessagesSent        ChatMessage[]
  chatAttachments         ChatAttachment[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTHENTICATION SUPPORT TABLES
// ─────────────────────────────────────────────────────────────────────────

// Refresh tokens are stored hashed (never the raw token) so a database leak
// alone doesn't grant usable credentials. Rotated on every use; reuse of an
// already-rotated token revokes the whole chain (theft detection).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  replacedById String?   @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Single-use, short-lived, hashed at rest.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Single-use MFA backup codes, hashed at rest.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean @default(false) @map("is_system")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Session store table shape is managed by connect-pg-simple's own migration
// (server/src/config/session.js creates it via `createTableIfMissing`), so it
// is intentionally NOT modeled here as a Prisma model.

// ─────────────────────────────────────────────────────────────────────────
// PROPERTIES
// ─────────────────────────────────────────────────────────────────────────

model Property {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  ownerId        String?           @map("owner_id") @db.Uuid
  propertyCode   String            @map("property_code")
  name           String
  propertyType   String            @map("property_type")
  description    String?
  address        String
  city           String?
  region         String?
  country        String?
  latitude       Decimal?          @db.Decimal(9, 6)
  longitude      Decimal?          @db.Decimal(9, 6)
  status         PropertyStatus    @default(active)
  // How the property is organised — see the property_structure migration.
  structureType  PropertyStructure @default(buildings_units) @map("structure_type")
  isShared       Boolean           @default(false) @map("is_shared")
  amenities      String[]          @default([])
  yearBuilt      Int?              @map("year_built")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner               Owner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  buildings           Building[]
  expenses            Expense[]
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]
  assignments         PropertyAssignment[]
  tenantMessages      TenantMessage[]
  rentals             TenantRental[]

  @@unique([organizationId, propertyCode])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@map("properties")
}

// A property_manager/agent only sees & manages properties they're
// explicitly assigned to (see docs/security/authorization.md and
// services/resourceAccess.service.js) — administrator/accountant/
// maintenance_manager/auditor get organization-wide access via their role
// permissions alone and never consult this table.
model PropertyAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("property_assignments")
}

model Building {
  id          String  @id @default(uuid()) @db.Uuid
  propertyId  String  @map("property_id") @db.Uuid
  name        String
  code        String?
  floors      Int?
  description String?
  // Created by the system for a whole property / units placed directly in a property.
  isImplicit  Boolean @default(false) @map("is_implicit")
  isShared    Boolean @default(false) @map("is_shared")

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units       Unit[]
  tenants     Tenant[]
  rentals     TenantRental[]
  inspections Inspection[]

  @@index([propertyId])
  @@map("buildings")
}

model Unit {
  id              String     @id @default(uuid()) @db.Uuid
  buildingId      String     @map("building_id") @db.Uuid
  unitNumber      String     @map("unit_number")
  unitType        String?    @map("unit_type")
  floor           Int?
  bedrooms        Int?
  bathrooms       Int?
  area            Decimal?   @db.Decimal(10, 2)
  monthlyRent     Decimal    @map("monthly_rent") @db.Decimal(14, 2)
  securityDeposit Decimal?   @map("security_deposit") @db.Decimal(14, 2)
  status          UnitStatus @default(available)
  description     String?
  // Stands for the whole property / whole building rather than one unit in it.
  // What the unit is offered for: renting, buying outright and/or a long lease.
  offerRent       Boolean    @default(true) @map("offer_rent")
  offerSale       Boolean    @default(false) @map("offer_sale")
  offerLease      Boolean    @default(false) @map("offer_lease")
  salePrice       Decimal?   @map("sale_price") @db.Decimal(14, 2)
  leasePrice      Decimal?   @map("lease_price") @db.Decimal(14, 2)
  leaseTermMonths Int?       @map("lease_term_months")
  isWhole         Boolean    @default(false) @map("is_whole")
  isShared        Boolean    @default(false) @map("is_shared")
  furnished       Boolean    @default(false)
  amenities       String[]   @default([])

  building            Building             @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  leases              Lease[]
  tenants             Tenant[]
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]
  rentals             TenantRental[]
  deals               Deal[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status])
  @@map("units")
}

// ─────────────────────────────────────────────────────────────────────────
// PEOPLE
// ─────────────────────────────────────────────────────────────────────────

model Owner {
  lands          Land[]
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String?     @unique @map("user_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  status         OwnerStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties   Property[]
  agentLinks   OwnerAgent[]

  @@index([organizationId])
  @@map("owners")
}

model Tenant {
  deals            Deal[]
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  userId           String?      @unique @map("user_id") @db.Uuid
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  email            String?
  phone            String?
  emergencyContact Json?        @map("emergency_contact")
  status           TenantStatus @default(active)
  // Convenience "where this tenant currently lives" reference, independent
  // of Lease history — a tenant can be associated with a building (e.g. a
  // commercial building contact) or a specific unit, optionally, without
  // requiring a formal lease record to exist yet.
  buildingId       String?      @map("building_id") @db.Uuid
  unitId           String?      @map("unit_id") @db.Uuid

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  building            Building?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  messagesSent        TenantMessage[]
  rentals             TenantRental[]

  @@index([organizationId])
  @@index([buildingId])
  @@index([unitId])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────
// LEASING
// ─────────────────────────────────────────────────────────────────────────

model Lease {
  deals           Deal[]
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  unitId          String      @map("unit_id") @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime    @map("end_date") @db.Date
  monthlyRent     Decimal     @map("monthly_rent") @db.Decimal(14, 2)
  securityDeposit Decimal?    @map("security_deposit") @db.Decimal(14, 2)
  paymentDueDay   Int         @default(1) @map("payment_due_day")
  renewalDate     DateTime?   @map("renewal_date") @db.Date
  status          LeaseStatus @default(draft)
  terms           Json?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  payments     Payment[]

  @@index([organizationId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  // Enforced again at the DB level via a partial unique index created in a
  // migration: CREATE UNIQUE INDEX ON leases (unit_id) WHERE status = 'active'
  // (Prisma cannot express partial indexes with a WHERE predicate natively
  // pre-5.x @@unique syntax, so this is added as a raw SQL migration step —
  // see database/migrations).
  @@map("leases")
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  leaseId        String?       @map("lease_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Decimal       @db.Decimal(14, 2)
  tax            Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balance        Decimal       @db.Decimal(14, 2)
  status         InvoiceStatus @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([tenantId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  leaseId        String?       @map("lease_id") @db.Uuid
  invoiceId      String?       @map("invoice_id") @db.Uuid
  dealId         String?       @map("deal_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  paymentDate    DateTime      @map("payment_date") @db.Timestamptz
  paymentMethod  PaymentMethod @map("payment_method")
  reference      String?
  idempotencyKey String?       @unique @map("idempotency_key")
  status         PaymentStatus @default(completed)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([dealId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model ExpenseCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
