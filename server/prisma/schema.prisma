enum ReferralStatus {
  pending
  approved
  paid
}

// Created automatically when someone registers with another user's
// referralCode (see auth.service.js#registerOrganization) — never created
// directly through the API. bonusAmount and status start unset/pending;
// an administrator/accountant reviews and pays out manually (see
// referral.service.js), there is no automatic invoice credit.
model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  referredId     String         @unique @map("referred_id") @db.Uuid
  code           String
  bonusAmount    Decimal?       @map("bonus_amount") @db.Decimal(14, 2)
  status         ReferralStatus @default(pending)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrer     User         @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred     User         @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([referrerId])
  @@map("referrals")
}

// Platform-level operator, structurally separate from Organization/User —
// intentionally NOT organizationId-scoped and never has an `organizationId`
// on its own row. Manages the Organization table itself (create tenants,
// activate/deactivate) through a dedicated auth flow (session keys
// `req.session.platformAdminId`, never `req.session.userId`) and dedicated
// middleware (`authenticatePlatformAdmin`), kept structurally apart from
// every tenant-scoped route so a platform-admin session can never be
// mistaken for — or granted — access to any tenant's operational data.
model PlatformAdmin {
  id                  String               @id @default(uuid()) @db.Uuid
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  email               String               @unique
  passwordHash        String               @map("password_hash")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz
  // A deactivated platform admin can't sign in or use an existing session,
  // but the row (and who they were) is kept rather than deleted.
  isActive            Boolean              @default(true) @map("is_active")
  avatarUpdatedAt     DateTime?            @map("avatar_updated_at") @db.Timestamptz
  avatar              PlatformAdminAvatar?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  passwordResetTokens PlatformAdminPasswordResetToken[]
  chatKey             ChatKey?
  chatMemberships     ChatMember[]
  chatMessagesSent    ChatMessage[]
  chatAttachments     ChatAttachment[]

  @@map("platform_admins")
}

// Same shape and semantics as PasswordResetToken, but for platform admins —
// a separate table because the two actor types never share identity rows.
// Doubles as the "set your password" invite token for a newly added admin.
model PlatformAdminPasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  platformAdminId String    @map("platform_admin_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_admin_password_reset_tokens")
}

// Append-only record of what platform admins do (sign-ins, organization and
// administrator changes). The actor is stored as a snapshot (id + name +
// email) rather than a foreign key, so the history survives that admin
// being deleted later.
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String?  @map("target_label")
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("platform_audit_logs")
}

enum RentalStatus {
  active
  ended
}

enum OwnerAgentStatus {
  active
  inactive
}

// One row per property/building/unit a tenant has rented. A tenant is ONE
// Tenant record (one person, one login) no matter how many places they
// rent; each additional rental is just another row here, never a new tenant.
// A unit rental sets unitId; a whole-building rental sets buildingId with no
// unitId. propertyId is always set so access scoping never needs a join.
model TenantRental {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  buildingId     String?      @map("building_id") @db.Uuid
  unitId         String?      @map("unit_id") @db.Uuid
  status         RentalStatus @default(active)
  // 'public_site' (the tenant asked via the company website) or 'staff'.
  source         String       @default("staff")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building     Building?    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@map("tenant_rentals")
}

// Links an agent (a user with the agent role) to an owner. An owner can
// have many agents and an agent can serve many owners; an agent sees the
// properties and tenants of every owner they hold an ACTIVE link to. An
// owner deactivating a link removes the agent's access to that owner only.
model OwnerAgent {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid
  agentUserId    String           @map("agent_user_id") @db.Uuid
  status         OwnerAgentStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, agentUserId])
  @@index([organizationId])
  @@index([agentUserId])
  @@map("owner_agents")
}

// ─────────────────────────────────────────────────────────────────────────
// CHAT (end-to-end encrypted)
//
// The server only ever stores ciphertext. Each person has an ECDH key pair
// made in their browser; the private half is stored here ONLY encrypted with
// a key derived from a chat passphrase the server never sees. Every room has
// one AES-256-GCM room key, generated in a member's browser and stored here
// only "wrapped" (encrypted) separately for each member's public key.
// Messages and files are encrypted with that key before they leave the
// browser. Anyone who is not a member of a room is never sent its wrapped
// key, messages or files.
// ─────────────────────────────────────────────────────────────────────────

enum ChatRoomType {
  community_tenants
  community_staff
  community_all
  direct
  support
}

// A person's chat identity: the public key others encrypt to, plus the
// passphrase-encrypted private key (so a new device can restore it).
// Exactly one of userId / platformAdminId is set.
model ChatKey {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String?  @unique @map("user_id") @db.Uuid
  platformAdminId     String?  @unique @map("platform_admin_id") @db.Uuid
  publicKey           String   @map("public_key")
  encryptedPrivateKey String   @map("encrypted_private_key")
  keySalt             String   @map("key_salt")
  keyIv               String   @map("key_iv")
  kdfIterations       Int      @default(250000) @map("kdf_iterations")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@map("chat_keys")
}

model ChatRoom {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  type           ChatRoomType
  name           String?
  // Makes "get or create" idempotent: one tenants community per organization,
  // one direct room per pair of people, one support room per organization.
  dedupeKey      String       @unique @map("dedupe_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ChatMember[]
  messages     ChatMessage[]
  attachments  ChatAttachment[]

  @@index([organizationId])
  @@map("chat_rooms")
}

model ChatMember {
  id               String    @id @default(uuid()) @db.Uuid
  roomId           String    @map("room_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  platformAdminId  String?   @map("platform_admin_id") @db.Uuid
  // The room key, wrapped (encrypted) for this member by another member's
  // browser; null until a member who holds the key has distributed it.
  wrappedKey       String?   @map("wrapped_key")
  wrapIv           String?   @map("wrap_iv")
  wrapperPublicKey String?   @map("wrapper_public_key")
  joinedAt         DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt       DateTime? @map("last_read_at") @db.Timestamptz

  room          ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@unique([roomId, platformAdminId])
  @@index([userId])
  @@index([platformAdminId])
  @@map("chat_members")
}

model ChatMessage {
  id                    String   @id @default(uuid()) @db.Uuid
  roomId                String   @map("room_id") @db.Uuid
  senderUserId          String?  @map("sender_user_id") @db.Uuid
  senderPlatformAdminId String?  @map("sender_platform_admin_id") @db.Uuid
  // AES-GCM ciphertext (base64) of a JSON payload (text, or a file's key and
  // metadata) and its IV — opaque to the server.
  ciphertext            String
  iv                    String
  attachmentId          String?  @unique @map("attachment_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  room                ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderUser          User?           @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  senderPlatformAdmin PlatformAdmin?  @relation(fields: [senderPlatformAdminId], references: [id], onDelete: Cascade)
  attachment          ChatAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// An encrypted file (picture, video, voice message): the bytes here are
// ciphertext; the key to open them travels inside the encrypted message.
model ChatAttachment {
  id                      String   @id @default(uuid()) @db.Uuid
  roomId                  String   @map("room_id") @db.Uuid
  uploaderUserId          String?  @map("uploader_user_id") @db.Uuid
  uploaderPlatformAdminId String?  @map("uploader_platform_admin_id") @db.Uuid
  data                    Bytes
  size                    Int
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  room                  ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploaderUser          User?          @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  uploaderPlatformAdmin PlatformAdmin? @relation(fields: [uploaderPlatformAdminId], references: [id], onDelete: Cascade)
  message               ChatMessage?

  @@index([roomId])
  @@map("chat_attachments")
}

// ─────────────────────────────────────────────────────────────────────────
// LANDS, DEALS AND PLATFORM SETTINGS
// ─────────────────────────────────────────────────────────────────────────

model Land {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  ownerId        String?    @map("owner_id") @db.Uuid
  title          String
  description    String?
  landType       String     @default("residential") @map("land_type")
  area           Decimal    @db.Decimal(14, 2)
  areaUnit       String     @default("acres") @map("area_unit")
  price          Decimal    @db.Decimal(14, 2)
  address        String?
  city           String?
  region         String?
  country        String?
  latitude       Decimal?   @db.Decimal(9, 6)
  longitude      Decimal?   @db.Decimal(9, 6)
  titleDocument  String?    @map("title_document")
  features       String[]   @default([])
  status         LandStatus @default(available)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]

  @@index([organizationId])
  @@index([status])
  @@map("lands")
}

// Someone renting, buying or leasing a house (a unit), or buying a land. The
// customer is a Tenant record; payments are recorded against the deal.
model Deal {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  kind           DealKind
  status         DealStatus @default(pending)
  tenantId       String     @map("tenant_id") @db.Uuid
  unitId         String?    @map("unit_id") @db.Uuid
  landId         String?    @map("land_id") @db.Uuid
  // Denormalised so a list can be narrowed to an owner's / agent's own
  // properties without joining through the unit.
  propertyId     String?    @map("property_id") @db.Uuid
  ownerId        String?    @map("owner_id") @db.Uuid
  leaseId        String?    @map("lease_id") @db.Uuid
  price          Decimal    @db.Decimal(14, 2)
  termMonths     Int?       @map("term_months")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  land         Land?        @relation(fields: [landId], references: [id], onDelete: SetNull)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([ownerId])
  @@index([kind, status])
  @@map("deals")
}

// Platform-wide switches (for example maintenance mode), one row per key.
model PlatformSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

// ── Backup & Recovery (platform admin) ───────────────────────────────────
// No relations on purpose: a restore rewrites the application tables and must
// never cascade into its own records. See docs/operations/backup-and-recovery.md.
model Backup {
  id              String    @id @default(uuid()) @db.Uuid
  type            String
  status          String    @default("PENDING")
  verification    String    @default("UNVERIFIED")
  sizeBytes       BigInt?   @map("size_bytes")
  checksumSha256  String?   @map("checksum_sha256")
  encrypted       Boolean   @default(false)
  storageProvider String    @map("storage_provider")
  storageKey      String?   @map("storage_key")
  tableCount      Int?      @map("table_count")
  rowCount        Int?      @map("row_count")
  tableCounts     Json?     @map("table_counts")
  schemaMigration String?   @map("schema_migration")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdByName   String?   @map("created_by_name")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  heartbeatAt     DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  requestId       String?   @map("request_id")

  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@map("backups")
}

model BackupRestore {
  id             String    @id @default(uuid()) @db.Uuid
  backupId       String    @map("backup_id") @db.Uuid
  safetyBackupId String?   @map("safety_backup_id") @db.Uuid
  status         String    @default("pending")
  startedById    String?   @map("started_by_id") @db.Uuid
  startedByName  String?   @map("started_by_name")
  backupTakenAt  DateTime? @map("backup_taken_at") @db.Timestamptz
  errorMessage   String?   @map("error_message")
  rolledBack     Boolean   @default(false) @map("rolled_back")
  verification   Json?
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  heartbeatAt    DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  requestId      String?   @map("request_id")

  @@index([startedAt(sort: Desc)])
  @@map("backup_restores")
}

model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  key          String
  scope        String
  method       String
  path         String
  requestHash  String    @map("request_hash")
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// A platform admin's profile picture (see migration 20261011090000).
model PlatformAdminAvatar {
  platformAdminId String        @id @map("platform_admin_id") @db.Uuid
  mimeType        String        @map("mime_type")
  data            Bytes
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@map("platform_admin_avatars")
}
